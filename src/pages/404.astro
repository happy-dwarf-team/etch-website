---
// The 404 page (docs/spec.md, section 3.6): the same header and footer as /, an h1 and links
// back to / and to the docs.
import Base from '../layouts/Base.astro';
import { docsUrl } from '../lib/content';
import { url } from '../lib/url';
---

<Base title="Page not found">
	<section class="wrap">
		<p class="eyebrow">404</p>
		<h1>Page not found</h1>
		<p class="muted">There is no page at this address.</p>
		<div class="buttons">
			<a class="button primary" href={url('/')}>Back to the Etch home page</a>
			<a class="button" href={docsUrl()}>Read the docs</a>
		</div>
	</section>
</Base>

<style>
	section {
		padding-block: clamp(3rem, 10vw, 7rem) 2rem;
	}

	h1 {
		margin-bottom: 0.75rem;
		font-size: clamp(1.75rem, 3vw + 1rem, 2.75rem);
	}

	p.muted {
		margin-bottom: 1.5rem;
	}

	.buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
	}
</style>
