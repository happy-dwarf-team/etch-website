---
// The document shell of every page: family and site styles, the head tags, the header and the
// footer (docs/spec.md, sections 3 and 7). A page adds its own head tags in the "head" slot.
import '../styles/forge-family.css';
import '../styles/site.css';
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';

interface Props {
	/** The page title without the site name. */
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<Head title={title} />
		<slot name="head" />
	</head>
	<body>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
