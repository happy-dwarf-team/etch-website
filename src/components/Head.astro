---
// Everything in <head> after charset and viewport (docs/spec.md, section 6): title,
// description, canonical, Open Graph and Twitter tags, icons, theme colour, the sitemap
// link and the JSON-LD SoftwareApplication. The images in public/ come from
// scripts/og-image.mjs and scripts/icons.mjs.
import { ETCH_REPO, getLatestVersion } from '../lib/release';
import { url } from '../lib/url';

interface Props {
	/** The page title without the site name, also used as og:title. */
	title: string;
}

const siteName = 'Etch';
const description =
	'A free VS Code extension that previews Europa Universalis IV interface mods: edit a .gui or .gfx file and see the window as the game draws it.';

const { title } = Astro.props;
// Crawlers need absolute URLs; Astro.site is SITE_URL and url() adds SITE_BASE.
const absolute = (path: string) => new URL(url(path), Astro.site).href;
// 404.html answers every missing URL, so it has no address of its own to name.
const canonical = /\/404\/?$/.test(Astro.url.pathname)
	? undefined
	: new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
const ogImage = absolute('og.png');

const softwareVersion = await getLatestVersion();
const softwareApplication = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: siteName,
	description,
	url: absolute('/'),
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Windows',
	license: 'https://opensource.org/licenses/MIT',
	isAccessibleForFree: true,
	...(softwareVersion && { softwareVersion }),
	author: { '@type': 'Organization', name: 'Happy Dwarf Team', url: 'https://happydwarf.dev/' },
	sameAs: `https://github.com/${ETCH_REPO}`,
};
---

<title>{`${title} | ${siteName}`}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
<meta name="theme-color" content="#16171a" />

<link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
<link rel="icon" href={url('favicon.ico')} sizes="32x32" />
<link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
<link rel="sitemap" href={url('sitemap-index.xml')} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteName} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="en" />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Etch, interface mod preview for VS Code" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />

{/* A JSON data block for search engines, not a script the browser runs. "<" is escaped so the data cannot close the element. */}
<script is:inline type="application/ld+json" set:html={JSON.stringify(softwareApplication).replace(/</g, '\\u003c')} />
