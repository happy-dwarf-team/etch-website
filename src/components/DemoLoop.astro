---
// A loop (docs/spec.md, section 4.1; DESIGN.md, "Demo loop"): a 16:9 figure with the silent
// video, the Pause/Play and Enlarge buttons and the text description. The controller below plays
// it only when it may, and Enlarge (or a click on the video) shows it large in the loop viewer
// (LoopViewer.astro); without the media manifest the figure shows its unavailable state. The
// hero's loop is the default; each feature of the tour passes its own text and id. The hero
// poster's preload link is in index.astro's head.
import type { GetImageResult } from 'astro';
import EtchMark from '../assets/etch-mark.svg';
import { LOOP } from '../lib/content';
import type { Loop } from '../lib/media';

interface Props {
	loop?: Loop;
	/** The poster as rendered by getImage(), the same URL the head preloads. */
	poster?: GetImageResult;
	/** The loop's title (the lead adds its length), its text description and its poster's alt. */
	text?: { title: string; descriptionHtml: string; posterAlt: string };
	/** The figure's id; the description's is `<id>-description`. */
	id?: string;
	/** What the button plays, for screen readers. */
	name?: string;
}

const { loop, poster, text = LOOP, id = 'demo-loop', name = 'the demo loop' } = Astro.props;
// "Pick mode, 12 s, silent." from the published loop's length (WCAG 1.2.1).
const lead = loop
	? `${text.title}, ${String(Math.round(loop.duration))} s, silent.`
	: `${text.title}, silent.`;
---

<figure class="demo-loop" id={id} data-demo-loop data-state={loop ? 'poster' : 'unavailable'}>
	<div class="media-box">
		{
			loop && poster ? (
				<video
					muted
					loop
					playsinline
					preload="none"
					poster={poster.src}
					width={loop.width}
					height={loop.height}
					aria-label={text.posterAlt}
					aria-describedby={`${id}-description`}
				>
					{loop.sources.map(({ src, type }) => (
						<source src={src} type={type} />
					))}
				</video>
			) : (
				<div class="media-unavailable">
					<EtchMark aria-hidden="true" focusable="false" />
					<p>Loop not published yet</p>
				</div>
			)
		}
		{
			loop && (
				<button type="button" class="media-control toggle" hidden>
					<svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
						<path fill="currentColor" d="M4 2.5v11l9-5.5z" />
					</svg>
					<svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
						<path fill="currentColor" d="M3.5 2.5h3.2v11H3.5zM9.3 2.5h3.2v11H9.3z" />
					</svg>
					<span class="label">Play</span>
					<span class="sr-only"> {name}</span>
				</button>
			)
		}
		{
			loop && (
				<button type="button" class="media-control enlarge" hidden>
					<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
						<circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8" />
						<path d="M10.3 10.3 14 14M5 7h4M7 5v4" stroke="currentColor" stroke-width="1.8" />
					</svg>
					Enlarge<span class="sr-only"> {name}</span>
				</button>
			)
		}
	</div>
	<figcaption id={`${id}-description`}>
		<strong>{lead}</strong>{' '}
		<Fragment set:html={text.descriptionHtml} />
	</figcaption>
</figure>

<style>
	.media-box {
		box-shadow: 0 24px 60px -30px rgb(0 0 0 / 0.8);
	}

	.toggle {
		position: absolute;
		right: 0.625rem;
		bottom: 0.625rem;
	}

	.toggle[hidden],
	.enlarge[hidden] {
		display: none;
	}

	.enlarge {
		position: absolute;
		left: 0.625rem;
		bottom: 0.625rem;
	}

	video {
		cursor: zoom-in;
	}

	.icon-pause,
	[data-playing] .icon-play {
		display: none;
	}

	[data-playing] .icon-pause {
		display: block;
	}

	figcaption {
		margin-top: 0.625rem;
		color: var(--forge-text-muted);
		font-size: 0.9rem;
	}

	figcaption strong {
		color: var(--forge-text);
		font-weight: 600;
	}
</style>

<script>
	// The loop controller (DESIGN.md, "Client JavaScript"). It plays the loop only with no
	// reduced-motion preference, without Save-Data and while at least half of it is in view in
	// a visible tab; it pauses otherwise and resumes on return. Reduced motion and Save-Data
	// leave the poster and a Play button. A refused play() stays on the poster; a source that
	// fails to load leaves the poster and the description (the unavailable state).
	type State = 'poster' | 'loading' | 'playing' | 'paused' | 'offscreen' | 'unavailable';

	// The loop viewer (LoopViewer.astro): one dialog for every loop, filled when it opens.
	const viewer = document.querySelector<HTMLDialogElement>('[data-loop-viewer]');
	const big = viewer?.querySelector('video');
	const bigCaption = viewer?.querySelector('[data-loop-viewer-caption]');
	let afterViewer: (() => void) | undefined;
	if (viewer && big) {
		// Empties the viewer and gives the page back; once per opening, whatever closed it.
		const finish = () => {
			if (afterViewer === undefined) return;
			big.pause();
			big.replaceChildren();
			big.removeAttribute('poster');
			big.load();
			const after = afterViewer;
			afterViewer = undefined;
			after();
		};
		const closeViewer = () => {
			viewer.close();
			finish();
		};
		viewer.querySelector('[data-close]')?.addEventListener('click', closeViewer);
		// A click on the backdrop, outside the dialog's box, closes it too.
		viewer.addEventListener('click', (event) => {
			if (event.target === viewer) closeViewer();
		});
		// Esc closes the dialog itself; its close event does not reach every browser in time.
		viewer.addEventListener('cancel', () => setTimeout(finish, 0));
		viewer.addEventListener('close', finish);
	}

	for (const figure of document.querySelectorAll<HTMLElement>('[data-demo-loop]')) {
		const video = figure.querySelector('video');
		const button = figure.querySelector<HTMLButtonElement>('.toggle');
		const enlarge = figure.querySelector<HTMLButtonElement>('.enlarge');
		if (!video || !button) continue;
		const label = button.querySelector('.label')!;
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
		const saveData = () =>
			(navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData ===
			true;

		video.muted = true;
		let inView = false;
		// What the visitor asked for with the button; null until they press it.
		let wants: 'play' | 'pause' | null = null;
		let started = false;

		const setState = (state: State) => {
			figure.dataset.state = state;
			const playing = state === 'playing' || state === 'loading';
			figure.toggleAttribute('data-playing', playing);
			label.textContent = playing ? 'Pause' : 'Play';
			button.hidden = state === 'unavailable';
		};

		const play = () => {
			if (figure.dataset.state === 'unavailable') return;
			setState(video.readyState >= 3 ? 'playing' : 'loading');
			video.play().then(
				() => {
					started = true;
					setState('playing');
				},
				(error: DOMException) => {
					// NotAllowedError: the browser refused playback; AbortError: pause() came first.
					if (error.name === 'NotAllowedError') setState(started ? 'paused' : 'poster');
					else if (error.name !== 'AbortError') setState('unavailable');
				},
			);
		};

		const pause = (state: State) => {
			video.pause();
			if (figure.dataset.state !== 'unavailable') setState(started ? state : 'poster');
		};

		const decide = () => {
			if (figure.dataset.state === 'unavailable') return;
			const mayAutoplay = !reducedMotion.matches && !saveData();
			if (wants === 'pause' || (wants === null && !mayAutoplay)) pause('paused');
			else if (!inView || document.hidden) pause('offscreen');
			else if (video.paused) play();
		};

		// Shows the loop large: the small one pauses, and plays on (as the rules allow) after.
		const openViewer = () => {
			if (!viewer || !big || !bigCaption || figure.dataset.state === 'unavailable') return;
			big.replaceChildren(...[...video.querySelectorAll('source')].map((s) => s.cloneNode()));
			big.poster = video.poster;
			big.setAttribute('aria-label', video.getAttribute('aria-label') ?? '');
			bigCaption.innerHTML = figure.querySelector('figcaption')?.innerHTML ?? '';
			pause('paused');
			// The focus goes back to this loop's Enlarge, whether it or the video opened the viewer.
			afterViewer = () => {
				enlarge?.focus({ preventScroll: true });
				decide();
			};
			viewer.showModal();
			big.load();
			if (!reducedMotion.matches && !saveData()) void big.play().catch(() => undefined);
		};
		if (enlarge && viewer) {
			enlarge.hidden = false;
			enlarge.addEventListener('click', openViewer);
			video.addEventListener('click', openViewer);
		}

		button.addEventListener('click', () => {
			if (figure.dataset.playing !== undefined) {
				wants = 'pause';
				pause('paused');
			} else {
				wants = 'play';
				play();
			}
		});

		// The last source's error means none could be played.
		const sources = video.querySelectorAll('source');
		sources[sources.length - 1]?.addEventListener('error', () => setState('unavailable'));
		video.addEventListener('error', () => setState('unavailable'));

		new IntersectionObserver(
			([entry]) => {
				inView = entry.intersectionRatio >= 0.5;
				decide();
			},
			{ threshold: [0, 0.5, 1] },
		).observe(figure.querySelector('.media-box')!);
		document.addEventListener('visibilitychange', decide);
		reducedMotion.addEventListener('change', decide);

		setState('poster');
	}
</script>
