---
// The footer on every page, 404 included (docs/spec.md, section 7): the family marker, Etch's
// links and the three-line disclaimer, since the site shows EU4 interface art. Discord goes
// through the hub's discord.happydwarf.dev redirect, so a new invite changes no code.
import logo from '../assets/happy-dwarf.svg?url';
import {
	CHANGELOG_URL,
	DISCORD_URL,
	docsUrl,
	ISSUES_URL,
	LICENSE_URL,
	REPO_URL,
} from '../lib/content';

const links = [
	{ href: docsUrl(), label: 'Docs' },
	{ href: CHANGELOG_URL, label: 'Changelog' },
	{ href: REPO_URL, label: 'Source code' },
	{ href: ISSUES_URL, label: 'Report a bug' },
	{ href: DISCORD_URL, label: 'Discord' },
	{ href: LICENSE_URL, label: 'Licence (MIT)' },
];
---

<footer class="site-footer">
	<div class="wrap">
		<a class="family" href="https://happydwarf.dev/">
			<img class="logo" src={logo} alt="" width="40" height="40" />
			A Happy Dwarf project
		</a>
		<ul class="links">
			{
				links.map(({ href, label }) => (
					<li>
						<a href={href}>{label}</a>
					</li>
				))
			}
		</ul>
		<p class="disclaimer">
			Etch is an unofficial community project, not affiliated with or endorsed by Paradox
			Interactive. Europa Universalis and Paradox Interactive are trademarks or registered
			trademarks of Paradox Interactive AB. Game interface art in screenshots and recordings is ©
			Paradox Interactive AB, rendered from a local copy of the game; Etch does not include or
			distribute game files.
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		border-top: 1px solid var(--forge-border);
	}

	.wrap {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		padding-block: 2rem calc(2.5rem + env(safe-area-inset-bottom, 0px));
		color: var(--forge-text-muted);
		font-size: 0.875rem;
	}

	.family {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 44px;
		color: var(--forge-text);
		text-decoration: none;
	}

	.family:hover {
		text-decoration: underline;
	}

	.logo {
		width: 2.5rem;
		height: 2.5rem;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.links a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--forge-text-muted);
	}

	.links a:hover {
		color: var(--forge-text);
	}

	.disclaimer {
		flex-basis: 100%;
		max-width: 52rem;
		font-size: 0.8125rem;
	}
</style>
