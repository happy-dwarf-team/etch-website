---
// The feature tour (docs/spec.md, sections 3.2 and 3.2.1; DESIGN.md, "Feature tour"): numbered
// rows, each a short text beside its feature's loop, sides alternating from 860 px. The offline
// preview's six rows and the live game's three use it; `start` continues the numbering. Without
// the media manifest every loop shows its unavailable state.
import { getImage } from 'astro:assets';
import type { Feature } from '../lib/content';
import type { Media } from '../lib/media';
import DemoLoop from './DemoLoop.astro';

interface Props {
	features: Feature[];
	loops?: Media['loops'];
	/** The number of the first row, less one. */
	start?: number;
}

const { features, loops, start = 0 } = Astro.props;

// The posters are below the first screen: one WebP each, not preloaded.
const posters = await Promise.all(
	features.map(async ({ clip }) => {
		const loop = loops?.[clip];
		return loop && (await getImage({ src: loop.poster, width: 1280, format: 'webp' }));
	}),
);
---

<ol class="tour" start={start + 1}>
	{
		features.map((feature, i) => (
			<li class="row">
				<div class="text">
					<p class="eyebrow" aria-hidden="true">
						{String(start + i + 1).padStart(2, '0')}
					</p>
					<h3>{feature.title}</h3>
					<p class="muted" set:html={feature.textHtml} />
				</div>
				<DemoLoop
					loop={loops?.[feature.clip]}
					poster={posters[i]}
					text={feature}
					id={`loop-${feature.clip}`}
					name={`the ${feature.title.toLowerCase()} loop`}
				/>
			</li>
		))
	}
</ol>

<style>
	.tour {
		display: grid;
		gap: clamp(2.5rem, 6vw, 4.5rem);
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}

	.row {
		display: grid;
		gap: 1.25rem;
		align-items: center;
	}

	@media (min-width: 860px) {
		.row {
			grid-template-columns: 1fr 1.4fr;
			gap: 2.5rem;
		}

		/* The loop keeps the wider column on either side. */
		.row:nth-child(even) {
			grid-template-columns: 1.4fr 1fr;
		}

		.row:nth-child(even) > .text {
			order: 2;
		}
	}

	h3 {
		margin-bottom: 0.5rem;
		font-size: 1.35rem;
	}

	.text :global(.source) {
		font-size: 0.9em;
	}
</style>
