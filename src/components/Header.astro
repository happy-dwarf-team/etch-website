---
// The sticky site header of the home page and 404 (docs/spec.md, section 3.1): the skip link and
// the header's content (HeaderBar.astro) in the content column. The docs show the same content
// in Starlight's header bar (src/components/docs/Header.astro).
import HeaderBar from './HeaderBar.astro';
---

<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
	<div class="wrap">
		<HeaderBar />
	</div>
</header>

<style>
	.skip {
		position: absolute;
		top: -4rem;
		left: 1rem;
		z-index: 50;
		padding: 0.6rem 1rem;
		border-radius: 0.5rem;
		background: var(--forge-accent);
		color: var(--forge-on-accent);
		font-weight: 600;
		text-decoration: none;
	}

	.skip:focus {
		top: calc(0.75rem + env(safe-area-inset-top, 0px));
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding-top: env(safe-area-inset-top, 0px);
		border-bottom: 1px solid var(--forge-border);
		background: color-mix(in srgb, var(--forge-bg) 92%, transparent);
		backdrop-filter: blur(8px);
	}
</style>
