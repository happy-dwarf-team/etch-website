---
// The home page (docs/spec.md, section 3.1): the hero with the What's new pill and the demo loop,
// the install band, the areas, the feature sections with their section players, the proof band
// and the closing call. Header and footer come from Base. Features, sections and areas without a
// clip in the media manifest are left out (section 3.2).
import { getImage } from 'astro:assets';
import CopyCommand from '../components/CopyCommand.astro';
import Loop from '../components/Loop.astro';
import LoopViewer from '../components/LoopViewer.astro';
import SectionPlayer from '../components/SectionPlayer.astro';
import Base from '../layouts/Base.astro';
import {
	CLOSING,
	DEMO_LOOP,
	DISCORD_URL,
	HERO,
	INSTALL,
	INSTALL_COMMAND,
	MARKETPLACE_URL,
	OPEN_VSX_URL,
	PROOF,
	demoChapters,
	docsUrl,
	getWhatsNewPill,
	shownSections,
} from '../lib/content';
import { loadMedia } from '../lib/media';

// Undefined until the first media refresh: the demo loop renders unavailable and no section shows.
const media = loadMedia();
const hero = media?.loops.hero;
// The poster is the LCP image: one same-origin WebP at the loop's own width, preloaded in the head.
const poster = hero && (await getImage({ src: hero.poster, width: 1920, format: 'webp' }));
const chapters = demoChapters(hero);
const sections = shownSections(media?.loops);
const pill = await getWhatsNewPill(sections);
---

<Base title="See your Europa Universalis IV mod in VS Code">
	{
		poster && (
			<link slot="head" rel="preload" as="image" href={poster.src} fetchpriority="high" />
		)
	}

	<section class="hero wrap" aria-labelledby="hero-title">
		<div class="hero-text">
			{
				pill && (
					<a class="whats-new" href={pill.href}>
						<span class="tag">New in {pill.version}</span>
						<span class="line">
							{pill.line} <span aria-hidden="true">→</span>
						</span>
					</a>
				)
			}
			<p class="eyebrow">{HERO.eyebrow}</p>
			<h1 id="hero-title">
				{HERO.title}
			</h1>
			<p class="lead">{HERO.lead}</p>
			<div class="buttons">
				<a class="button primary" href={MARKETPLACE_URL}>Install from VS Code Marketplace</a>
				<a class="button" href={OPEN_VSX_URL}>Open VSX</a>
				<a class="text-link" href={docsUrl()}>Read the docs <span aria-hidden="true">→</span></a>
			</div>
			<ul class="requirements" aria-label="Requirements">
				{HERO.requirements.map((r) => <li>{r}</li>)}
			</ul>
		</div>
		<Loop id="demo-loop" loop={hero} poster={poster} text={DEMO_LOOP} repeat chapters={chapters} />
	</section>

	<section class="install" aria-labelledby="install-title">
		<div class="wrap">
			<h2 id="install-title">Install in one line</h2>
			<div class="install-row">
				<CopyCommand command={INSTALL_COMMAND} />
				<p class="muted">
					<Fragment set:html={INSTALL.textHtml} />{' '}
					<a class="arrow-link" href={INSTALL.link.href}>
						{INSTALL.link.label} <span aria-hidden="true">→</span>
					</a>
				</p>
			</div>
		</div>
	</section>

	<div class="wrap" id="features">
		{
			sections.length > 0 && (
				<nav class="areas" aria-label="What Etch works on" style={`--areas: ${String(sections.length)}`}>
					<ul>
						{sections.map(({ id, area }) => (
							<li>
								<a class="area" href={`#${id}`}>
									<span class="files">{area.files}</span>
									<span class="name">
										{area.name}
										{pill?.target === id && <span class="new">new</span>}
									</span>
									<span class="area-line" set:html={area.lineHtml} />
								</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}

		{
			sections.map((section) => (
				<section class="feature-section" id={section.id} aria-labelledby={`${section.id}-title`}>
					<div class="section-head">
						<p class="eyebrow">{section.eyebrow}</p>
						<h2 id={`${section.id}-title`}>{section.title}</h2>
						<p class="muted" set:html={section.sentenceHtml} />
					</div>
					<SectionPlayer section={section} />
					{section.note && (
						<p class="note">
							<Fragment set:html={section.note.textHtml} />{' '}
							<a class="arrow-link" href={section.note.link.href}>
								{section.note.link.label} <span aria-hidden="true">→</span>
							</a>
						</p>
					)}
				</section>
			))
		}
	</div>

	<div class="wrap">
		<ul class="proof" aria-label="Etch in numbers">
			{
				PROOF.map(({ fact, line, href }) => (
					<li>
						<a href={href}>
							<span class="fact">{fact}</span>
							<span class="fact-line">{line}</span>
						</a>
					</li>
				))
			}
		</ul>

		<section class="closing" aria-labelledby="closing-title">
			<h2 id="closing-title">{CLOSING.title}</h2>
			<p class="muted" set:html={CLOSING.textHtml} />
			<div class="buttons">
				<a class="button primary" href={MARKETPLACE_URL}>Install from VS Code Marketplace</a>
				<a class="button" href={docsUrl()}>Read the docs</a>
				<a class="text-link" href={DISCORD_URL}>Discord <span aria-hidden="true">→</span></a>
			</div>
		</section>
	</div>
	{media && <LoopViewer />}
</Base>

<style>
	/* Hero: the text centred above the demo loop, which takes the content's full width. */
	.hero {
		padding-block: clamp(2rem, 5vw, 4.5rem) 0;
	}

	.hero-text {
		text-align: center;
	}

	.whats-new {
		display: inline-flex;
		align-items: stretch;
		max-width: 100%;
		min-height: 44px;
		margin-bottom: 1.25rem;
		overflow: hidden;
		border: 1px solid var(--forge-accent);
		border-radius: 999px;
		color: var(--forge-text);
		font-size: 0.875rem;
		line-height: 1.35;
		text-align: left;
		text-decoration: none;
	}

	.whats-new .tag {
		display: flex;
		align-items: center;
		flex: none;
		padding: 0.35rem 0.75rem;
		background: var(--forge-accent);
		color: var(--forge-on-accent);
		font: 700 0.75rem/1.3 var(--forge-font-mono);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.whats-new .line {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35rem 1rem 0.35rem 0.75rem;
		background: var(--forge-accent-soft);
		transition: background-color 180ms var(--forge-ease);
	}

	.whats-new:hover {
		color: var(--forge-text);
	}

	.whats-new:hover .line {
		background: color-mix(in srgb, var(--forge-accent-soft) 70%, var(--forge-accent));
	}

	.hero .eyebrow {
		margin-bottom: 1rem;
	}

	h1 {
		max-width: 20ch;
		margin: 0 auto 1rem;
		font-size: clamp(1.75rem, 3.6vw + 0.9rem, 3.5rem);
	}

	.lead {
		max-width: 46rem;
		margin: 0 auto 1.5rem;
		color: var(--forge-text-muted);
		font-size: clamp(1rem, 0.4vw + 0.92rem, 1.15rem);
	}

	.buttons {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.625rem;
	}

	.hero .buttons {
		justify-content: center;
	}

	/* A text link that is still a 44 px target. */
	.text-link,
	.arrow-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 44px;
		font-weight: 600;
	}

	.text-link {
		padding-inline: 0.6rem;
		text-decoration: none;
	}

	.text-link:hover {
		text-decoration: underline;
	}

	.requirements {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25rem 1.1rem;
		margin: 1rem 0 0;
		padding: 0;
		color: var(--forge-text-muted);
		font: 500 0.8rem/1.5 var(--forge-font-mono);
		list-style: none;
	}

	.requirements li + li::before {
		content: '·';
		margin-right: 1.1rem;
		color: var(--forge-accent);
	}

	.hero :global(.loop) {
		margin-top: clamp(1.75rem, 4vw, 3rem);
	}

	/* Install band */
	.install {
		margin-top: clamp(3rem, 7vw, 5rem);
		border-block: 1px solid var(--forge-border);
		background: var(--forge-surface);
	}

	.install .wrap {
		padding-block: 1.75rem;
	}

	.install h2 {
		margin-bottom: 0.75rem;
		font-size: 1.15rem;
	}

	.install-row {
		display: grid;
		gap: 0.75rem 2rem;
		align-items: center;
	}

	.install-row > :global(*) {
		min-width: 0;
	}

	@media (min-width: 860px) {
		.install-row {
			grid-template-columns: minmax(0, auto) minmax(0, 1fr);
		}
	}

	/* Areas: four in one row from 980 px, two by two from 600 px, one column below. */
	.areas ul {
		display: grid;
		gap: 0.75rem;
		margin: clamp(3rem, 7vw, 5rem) 0 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 600px) {
		.areas ul {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 980px) {
		.areas ul {
			grid-template-columns: repeat(var(--areas), minmax(0, 1fr));
		}
	}

	.area {
		display: grid;
		align-content: start;
		gap: 0.3rem;
		height: 100%;
		padding: 1rem 1.1rem;
		border: 1px solid var(--forge-border);
		border-radius: var(--forge-radius);
		background: var(--forge-surface);
		color: var(--forge-text);
		text-decoration: none;
		transition: border-color 180ms var(--forge-ease);
	}

	.area:hover,
	.area:focus-visible {
		border-color: var(--forge-accent);
		color: var(--forge-text);
	}

	.files {
		color: var(--forge-text-muted);
		font: 500 0.75rem/1.5 var(--forge-font-mono);
	}

	.name {
		font: 700 1.02rem/1.35 var(--forge-font-mono);
	}

	.new {
		margin-left: 0.5rem;
		padding: 0.05rem 0.45rem;
		border-radius: 999px;
		background: var(--forge-accent);
		color: var(--forge-on-accent);
		font: 700 0.68rem/1.5 var(--forge-font-mono);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		vertical-align: 0.15em;
	}

	.area-line {
		color: var(--forge-text-muted);
		font-size: 0.9rem;
		line-height: 1.45;
	}

	/* Feature sections */
	.feature-section {
		padding-top: clamp(4rem, 9vw, 6.5rem);
	}

	.section-head {
		max-width: 46rem;
		margin-bottom: 1.75rem;
	}

	.section-head h2 {
		margin-bottom: 0.6rem;
		font-size: clamp(1.5rem, 1.9vw + 0.9rem, 2.25rem);
	}

	.note {
		max-width: 46rem;
		margin-top: 1.25rem;
		color: var(--forge-text-muted);
		font-size: 0.95rem;
	}

	/* Proof band: three facts in one row from 720 px. */
	.proof {
		display: grid;
		gap: 0.75rem;
		margin: clamp(4rem, 9vw, 6.5rem) 0 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 720px) {
		.proof {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.proof a {
		display: grid;
		align-content: start;
		gap: 0.4rem;
		height: 100%;
		padding: 1.4rem 1.5rem;
		border: 1px solid var(--forge-border);
		border-radius: var(--forge-radius);
		background: var(--forge-surface);
		text-decoration: none;
		transition: border-color 180ms var(--forge-ease);
	}

	.proof a:hover,
	.proof a:focus-visible {
		border-color: var(--forge-accent);
	}

	.fact {
		color: var(--forge-text);
		font: 700 clamp(1.6rem, 1.5vw + 1rem, 2.1rem)/1.15 var(--forge-font-mono);
		letter-spacing: -0.02em;
	}

	.fact-line {
		color: var(--forge-text-muted);
		font-size: 0.95rem;
	}

	/* Closing call */
	.closing {
		margin-top: clamp(4rem, 9vw, 6.5rem);
		padding: clamp(1.5rem, 5vw, 3rem);
		border: 1px solid var(--forge-border);
		border-radius: var(--forge-radius);
		background: radial-gradient(120% 140% at 0% 0%, var(--forge-accent-soft), var(--forge-surface) 55%);
	}

	.closing h2 {
		margin-bottom: 0.5rem;
		font-size: clamp(1.4rem, 1.6vw + 0.9rem, 2rem);
	}

	.closing p {
		max-width: 40rem;
		margin-bottom: 1.25rem;
	}

	.closing :global(strong) {
		color: var(--forge-text);
		white-space: nowrap;
	}
</style>
