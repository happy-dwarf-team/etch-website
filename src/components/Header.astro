---
// The sticky site header on every page (docs/spec.md, section 3.1): skip link, the Etch mark
// and wordmark, the status badge, the three section anchors and the GitHub link. Two rows
// below 640 px, one row from 640 px; no menu button.
import EtchMark from '../assets/etch-mark.svg';
import { getStatus, REPO_URL } from '../lib/content';
import { getLatestVersion } from '../lib/release';
import { url } from '../lib/url';

const sections = [
	{ id: 'features', label: 'Features' },
	{ id: 'install', label: 'Install' },
	{ id: 'roadmap', label: 'Roadmap' },
];

// "Preview · 0.2.0"; only the status when the release could not be fetched.
const { status } = await getStatus();
const version = await getLatestVersion();
const badge = version ? `${status} · ${version}` : status;
---

<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
	<div class="wrap">
		<div class="brand">
			<a class="home" href={url('/')}>
				<EtchMark width={32} height={32} aria-hidden="true" focusable="false" />
				Etch
			</a>
			<span class="badge">{badge}</span>
		</div>
		<nav class="nav" aria-label="Main">
			<ul>
				{
					sections.map(({ id, label }) => (
						<li>
							<a href={`${url('/')}#${id}`}>{label}</a>
						</li>
					))
				}
			</ul>
		</nav>
		<a class="github" href={REPO_URL}>
			<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
				<path
					fill="currentColor"
					d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"
				></path>
			</svg>
			<span class="sr-only">Etch on GitHub</span>
		</a>
	</div>
</header>

<style>
	.skip {
		position: absolute;
		top: -4rem;
		left: 1rem;
		z-index: 50;
		padding: 0.6rem 1rem;
		border-radius: 0.5rem;
		background: var(--forge-accent);
		color: var(--forge-on-accent);
		font-weight: 600;
		text-decoration: none;
	}

	.skip:focus {
		top: calc(0.75rem + env(safe-area-inset-top, 0px));
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding-top: env(safe-area-inset-top, 0px);
		border-bottom: 1px solid var(--forge-border);
		background: color-mix(in srgb, var(--forge-bg) 92%, transparent);
		backdrop-filter: blur(8px);
	}

	/* Below 640 px: mark, badge and GitHub on top, the anchors in one row below. */
	.wrap {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas:
			'brand github'
			'nav nav';
		align-items: center;
		align-content: center;
		column-gap: 1rem;
		min-height: var(--header-height);
	}

	.brand {
		grid-area: brand;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.75rem;
	}

	.home {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 44px;
		color: var(--forge-text);
		font: 700 1rem/1 var(--forge-font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
	}

	.home svg {
		flex: none;
		width: 2rem;
		height: 2rem;
		color: var(--forge-accent);
	}

	.badge {
		padding: 0.15rem 0.6rem;
		border: 1px solid var(--forge-accent);
		border-radius: 999px;
		background: var(--forge-accent-soft);
		color: var(--forge-accent-strong);
		font: 500 0.78rem/1.4 var(--forge-font-mono);
		white-space: nowrap;
	}

	.nav {
		grid-area: nav;
		/* Lines the first anchor's text up with the mark. */
		margin-left: -0.7rem;
	}

	.nav ul {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav a,
	.github {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		border-radius: 0.5rem;
		color: var(--forge-text-muted);
		text-decoration: none;
		transition:
			color 160ms var(--forge-ease),
			background-color 160ms var(--forge-ease);
	}

	.nav a {
		padding-inline: 0.7rem;
		font-size: 0.95rem;
		white-space: nowrap;
	}

	.nav a:hover,
	.github:hover {
		background: var(--forge-surface);
		color: var(--forge-text);
	}

	.github {
		grid-area: github;
		justify-content: center;
		width: 44px;
	}

	@media (min-width: 640px) {
		.wrap {
			grid-template-columns: 1fr auto auto;
			grid-template-areas: 'brand nav github';
			column-gap: 0.25rem;
		}

		.nav {
			margin-left: 0;
		}
	}
</style>
