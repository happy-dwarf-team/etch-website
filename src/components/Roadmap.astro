---
// The roadmap timeline (docs/spec.md, section 3.5; DESIGN.md, "Roadmap timeline"): M0 to
// 1.0.0 as a vertical list, each milestone's state shown by a marker and by text; the current
// milestone uses the accent. States come from src/data/status.yaml.
import { getStatus } from '../lib/content';

const { roadmap } = await getStatus();
const stateLabel = { done: 'Done', current: 'Current', next: 'Next' } as const;
---

<ol class="timeline">
	{
		roadmap.map(({ id, name, version, line, state }) => (
			<li class={state} aria-current={state === 'current' ? 'step' : undefined}>
				<span class="marker" aria-hidden="true" />
				<h3>
					<span>
						{id} {name}
					</span>
					{version && <span class="version">{version}</span>}
					<span class="state">{stateLabel[state]}</span>
				</h3>
				<p>{line}</p>
			</li>
		))
	}
</ol>

<style>
	.timeline {
		position: relative;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}

	li {
		position: relative;
		padding: 0 0 1.75rem 2.25rem;
	}

	/* The line between two markers. */
	li::before {
		content: '';
		position: absolute;
		top: 1.5rem;
		bottom: -0.125rem;
		left: 0.4375rem;
		width: 2px;
		background: var(--forge-border);
	}

	li.done::before {
		background: var(--forge-accent);
	}

	li:last-child::before {
		display: none;
	}

	.marker {
		position: absolute;
		top: 0.25rem;
		left: 0;
		width: 1rem;
		height: 1rem;
		border: 2px solid var(--forge-border);
		border-radius: 50%;
		background: var(--forge-bg);
	}

	.done .marker {
		border-color: var(--forge-accent);
		background: var(--forge-accent);
	}

	.current .marker {
		border-color: var(--forge-accent);
		box-shadow: 0 0 0 4px var(--forge-accent-soft);
	}

	.current .marker::after {
		content: '';
		position: absolute;
		inset: 2px;
		border-radius: 50%;
		background: var(--forge-accent);
	}

	h3 {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.75rem;
		margin-bottom: 0.25rem;
		font-size: 1.05rem;
	}

	.version {
		color: var(--forge-text-muted);
		font-size: 0.85rem;
		font-weight: 500;
	}

	.state {
		padding: 0.05rem 0.5rem;
		border: 1px solid var(--forge-border);
		border-radius: 999px;
		color: var(--forge-text-muted);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.done .state {
		color: var(--forge-accent-strong);
	}

	.current .state {
		border-color: var(--forge-accent);
		background: var(--forge-accent-soft);
		color: var(--forge-accent-strong);
	}

	.current h3 {
		color: var(--forge-accent-strong);
	}

	p {
		color: var(--forge-text-muted);
	}
</style>
